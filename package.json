{
  "name": "pressycms",
  "version": "0.1.0",
  "private": true,
  "description": "PressyCMS — a database-free, Git-native CMS. Write a markdown file, push, done.",
  "license": "MIT",
  "bin": {
    "pressy": "bin/pressy.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node bin/pressy.js build",
    "serve": "node bin/pressy.js serve",
    "dev": "node bin/pressy.js serve",
    "lint": "node bin/pressy.js lint",
    "new": "node bin/pressy.js new",
    "mcp": "node bin/pressy.js mcp",
    "test": "node --test test/*.test.js",
    "screenshots": "node scripts/screenshots.js",
    "gifs": "node scripts/gifs.js"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.1.1"
  }
}
